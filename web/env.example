# Example environment configuration for the web frontend
# Copy this to .env.local and adjust as needed

# Backend API URL (leave empty to use same host)
# For development, the Next.js proxy handles this automatically
NEXT_PUBLIC_API_URL=

# WebSocket host (leave empty to use window.location.host)
# Only needed if backend is on a different host/port in production
NEXT_PUBLIC_WS_HOST=


